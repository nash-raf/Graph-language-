// SGPL workload: bfs_n512_d160_i4_s2_c1_r100000_t2_loop
// Run all variants on this identical source.
graph G {
  edges: file "../graphs/ring_n512_d160.txt";
};
int checksum = 0;
// Phase 0: initial scans.
int probe_0_pre = 0;
while (probe_0_pre < 2) {
query scan_0_pre: "bfs_src" of G;
  probe_0_pre = probe_0_pre + 1;
}
// Phase 0: insert a batch of absent in-bounds edges.
int batch_0 = 0;
while (batch_0 < 100000) {
G.addEdges(0->191);
G.removeEdges(0->191);
G.addEdges(37->228);
G.removeEdges(37->228);
G.addEdges(74->265);
G.removeEdges(74->265);
G.addEdges(111->302);
G.removeEdges(111->302);
  batch_0 = batch_0 + 1;
}
// Phase 0: scan the updated graph.
int probe_0_post = 0;
while (probe_0_post < 2) {
query scan_0_post: "bfs_src" of G;
  probe_0_post = probe_0_post + 1;
}
print checksum;
print numEdges(G);
