graph G { directed: true; edges: file "rtest_small.txt"; };
int n = numVertices(G);
int data[n];
int acc = 0;
int q = 0;
int roundEffect = 0;
int r = 0;
while (r < 3) {
  roundEffect = roundEffect + 1;
  r = r + 1;
  for u in G.nodes {
    acc = 0;
    for v in G.neighbors(u) {
      acc = acc + v + 1;
      data[u] = data[u] + acc;
    }
    q = q + 1;
  }
}
int total = q + roundEffect;
for u in G.nodes { total = total + data[u]; }
print total;
print r;
