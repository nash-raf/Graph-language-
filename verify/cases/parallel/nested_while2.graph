graph G { edges: file "../verify/fixtures/g20k.txt"; };
int n = numVertices(G);
int acc[n];
for u in G.nodes
{
    acc[u] = 0;
    int a = 0;
    while (a < 2)
    {
        int b = 0;
        while (b < 2)
        {
            for v in G.neighbors(u)
            {
                acc[u] = acc[u] + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }
}
print "acc0";
print acc[0];
