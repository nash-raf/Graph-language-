graph G { directed: true; edges: file "rtest_small.txt"; };
int n = numVertices(G);
int pairs[n];
int expected = 0;
int bad = 0;
for u in G.nodes {
  if (u != expected) { bad = bad + 1; }
  for v in G.neighbors(u) { pairs[u] = pairs[u] + v; }
  expected = expected + 1;
}
int total = 0;
for u in G.nodes { total = total + pairs[u]; }
print total;
print expected;
print bad;
