graph G {
  directed: true;
  edges: file "roundsep_small.txt";
};

int n = numVertices(G);
int dist[n];

for v in G.nodes {
  dist[v] = v;
}

for u in G.nodes {
  for v in G.neighbors(u) {
    if (dist[u] + 1 < dist[v]) {
      dist[v] = dist[u] + 1;
    }
  }
}

for v in G.nodes {
  print dist[v];
}