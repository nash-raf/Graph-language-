graph G {
  edges: file "undirected_small.txt";
};

int n = numVertices(G);
int id[n];
set frontier;
set next;

for each vertex v in G {
  id[v] = v;
}

frontier = G.nodes;

while (setSize(frontier) > 0) {
  next = {};
  for each element u in frontier {
    for each neighbor v of u in G {
      if (id[u] < id[v]) {
        id[v] = id[u];
        next.add(v);
      }
    }
  }
  frontier = next;
}

print id[0];
print id[1];
print id[2];
print id[3];
