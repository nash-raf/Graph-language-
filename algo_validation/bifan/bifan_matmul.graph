// Bi-fan count by the closed form, in GraphEasy.
//   A = 512x512 bipartite adjacency (sources 0..511, targets 512..1023)
//   M = A * A^T   -> M[i][j] = targets shared by sources i and j
//   bifans = sum over i<j of C(M[i][j],2)
// The triple nest is affine with local arrays inside a `fn`, so Polly can
// form a SCoP.  Accumulator is `real` (double) because the count exceeds int32.
graph G {
  directed;
  edges: file "/home/user/Course/msk1/2nd/Graph-language-/algo_validation/bifan/real_layer.txt";
};

fn void bifan() {
  int S = 512;
  int A[512][512];

  int i = 0;
  while (i < S) {
    int j = 0;
    while (j < S) { A[i][j] = 0; j = j + 1; }
    i = i + 1;
  }

  for each edge u, v in G {
    A[u][v - S] = 1;
  }

  real total = 0.0;
  i = 0;
  while (i < S) {
    int j = i + 1;
    while (j < S) {
      int c = 0;
      int t = 0;
      while (t < S) {
        c = c + A[i][t] * A[j][t];
        t = t + 1;
      }
      total = total + (c * (c - 1)) / 2;
      j = j + 1;
    }
    i = i + 1;
  }

  print "bifan_matmul";
  print total;
}

bifan();
