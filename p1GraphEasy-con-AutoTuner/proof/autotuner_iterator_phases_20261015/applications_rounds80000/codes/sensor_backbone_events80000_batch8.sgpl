// Radio-link duty cycles followed by a redundant-neighbor k-core audit.
// Synthetic projected-community fixture shared by all five different programs.
graph G { edges: file "../graphs/community_projection.txt"; };
int n=numVertices(G);
// Degree cache supplied with the snapshot and maintained with every update.
int out_degree[544]=[501,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,1];
int window = 0;
while (window < 80000) {
  G.removeEdges(402->502);
  out_degree[402] = out_degree[402] - 1;
  out_degree[502] = out_degree[502] - 1;
  G.removeEdges(403->503);
  out_degree[403] = out_degree[403] - 1;
  out_degree[503] = out_degree[503] - 1;
  G.removeEdges(404->504);
  out_degree[404] = out_degree[404] - 1;
  out_degree[504] = out_degree[504] - 1;
  G.removeEdges(405->505);
  out_degree[405] = out_degree[405] - 1;
  out_degree[505] = out_degree[505] - 1;
  G.removeEdges(406->506);
  out_degree[406] = out_degree[406] - 1;
  out_degree[506] = out_degree[506] - 1;
  G.removeEdges(407->507);
  out_degree[407] = out_degree[407] - 1;
  out_degree[507] = out_degree[507] - 1;
  G.removeEdges(408->508);
  out_degree[408] = out_degree[408] - 1;
  out_degree[508] = out_degree[508] - 1;
  G.removeEdges(409->509);
  out_degree[409] = out_degree[409] - 1;
  out_degree[509] = out_degree[509] - 1;
  G.addEdges(402->502);
  out_degree[402] = out_degree[402] + 1;
  out_degree[502] = out_degree[502] + 1;
  G.addEdges(403->503);
  out_degree[403] = out_degree[403] + 1;
  out_degree[503] = out_degree[503] + 1;
  G.addEdges(404->504);
  out_degree[404] = out_degree[404] + 1;
  out_degree[504] = out_degree[504] + 1;
  G.addEdges(405->505);
  out_degree[405] = out_degree[405] + 1;
  out_degree[505] = out_degree[505] + 1;
  G.addEdges(406->506);
  out_degree[406] = out_degree[406] + 1;
  out_degree[506] = out_degree[506] + 1;
  G.addEdges(407->507);
  out_degree[407] = out_degree[407] + 1;
  out_degree[507] = out_degree[507] + 1;
  G.addEdges(408->508);
  out_degree[408] = out_degree[408] + 1;
  out_degree[508] = out_degree[508] + 1;
  G.addEdges(409->509);
  out_degree[409] = out_degree[409] + 1;
  out_degree[509] = out_degree[509] + 1;
  window = window + 1;
}
  G.removeEdges(0->1);
  out_degree[0] = out_degree[0] - 1;
  out_degree[1] = out_degree[1] - 1;
  G.removeEdges(0->2);
  out_degree[0] = out_degree[0] - 1;
  out_degree[2] = out_degree[2] - 1;
  G.removeEdges(0->3);
  out_degree[0] = out_degree[0] - 1;
  out_degree[3] = out_degree[3] - 1;
  G.removeEdges(0->4);
  out_degree[0] = out_degree[0] - 1;
  out_degree[4] = out_degree[4] - 1;
  G.removeEdges(0->5);
  out_degree[0] = out_degree[0] - 1;
  out_degree[5] = out_degree[5] - 1;
  G.removeEdges(0->6);
  out_degree[0] = out_degree[0] - 1;
  out_degree[6] = out_degree[6] - 1;
  G.removeEdges(0->7);
  out_degree[0] = out_degree[0] - 1;
  out_degree[7] = out_degree[7] - 1;
  G.removeEdges(0->8);
  out_degree[0] = out_degree[0] - 1;
  out_degree[8] = out_degree[8] - 1;
  G.removeEdges(0->9);
  out_degree[0] = out_degree[0] - 1;
  out_degree[9] = out_degree[9] - 1;
  G.removeEdges(0->10);
  out_degree[0] = out_degree[0] - 1;
  out_degree[10] = out_degree[10] - 1;
  G.removeEdges(0->11);
  out_degree[0] = out_degree[0] - 1;
  out_degree[11] = out_degree[11] - 1;
  G.removeEdges(0->12);
  out_degree[0] = out_degree[0] - 1;
  out_degree[12] = out_degree[12] - 1;
  G.removeEdges(0->512);
  out_degree[0] = out_degree[0] - 1;
  out_degree[512] = out_degree[512] - 1;
query core_snapshot: "bfs_src" 0 of G;
query edge_snapshot: "bfs_src" 543 of G;
print core_snapshot; print edge_snapshot;
// Peel sensors that cannot meet the minimum redundant-neighbor budget.
int alive[n]; int deg[n]; int frontier[n]; int next_frontier[n];
int k=490; int frontier_size=0; int next_size=0; int v=0;
while(v<n) { alive[v]=1; deg[v]=out_degree[v]; if(deg[v]<k) { frontier[frontier_size]=v; frontier_size=frontier_size+1; } v=v+1; }
while(frontier_size>0) {
  next_size=0; int i=0;
  while(i<frontier_size) {
    int u=frontier[i];
    if(alive[u]==1) {
      alive[u]=0;
      for v in G.neighbors(u) {
        if(alive[v]==1) {
          deg[v]=deg[v]-1;
          if(deg[v]<k) { next_frontier[next_size]=v; next_size=next_size+1; }
        }
      }
    }
    i=i+1;
  }
  swap(frontier,next_frontier); frontier_size=next_size;
}
int retained=0; v=0;
while(v<n) { retained=retained+alive[v]; v=v+1; }
print retained; print alive[0];
print numEdges(G);
