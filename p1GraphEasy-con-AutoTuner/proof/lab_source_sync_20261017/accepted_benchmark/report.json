  "general_fix": "Combine independent partition completion publications per worker; retain weighted packed records and compiler weight-hint lowering. No algorithm/graph-name dispatch. Keep 32-worker budget.",
  "cause_evidence": [
    "RoadNet-CA uses mode 1 in all 555 rounds, not weighted packed mode 2; baseline and packing compiler-generated BFS objects are byte-identical.",
    "Earlier packing build slowed shared record preparation/dispatch; sampled cycles were dominated by worker-pool waiting (~64%).",
    "Independent spatial workers performed a shared atomic completion update after every node, although completion is consumed only after the pool joins. New code aggregates that count per worker.",
    "Profile does not establish the exact CPU/cache-layout cause of the prior packing-only slowdown. The small RoadNet difference versus current P1 is within run-to-run variation."
  ],
  "rejected_trial": {
    "stage": "02_active_lanes",
    "reason": "Reducing physical lanes to active nodes regressed Asia BFS and CC on confirmation; not installed."
  },
  "guardrail": "RoadNet ten-launch pooled means and medians must not regress vs current; SSSP aggregate means/medians improve and retain original packing gains; no pooled checked case may regress >1% by either mean or median.",
  "semantics_preserved": [
    "duplicate pair occurrences",
    "append order and source lifecycle",
    "source/partition/round callbacks and combines",
    "first-match duplicate-edge weights",
    "mutation and layout invalidation",
    "device fallback expansion",
    "nested budgets and balanced reservations",
    "ordinary doall/doacross and TDG decisions"
  ],
  "timing_policy": "5 fresh whole-process launches per variant, rotating execution order; one excluded warmup plus separate untimed reference validation. Loading, initialization, computation, teardown and exit included; compilation excluded. Raw primary and confirmation data kept; no instrumented run used as benchmark.",
  "historical_273_batch_unchanged": true
}
