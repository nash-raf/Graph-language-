graph G {
  edges: file "/home/user/Course/msk1/2nd/Graph-language-/p2GraphEasy/large_validation/synth_v100000_e10000000.txt";
};

int n = numVertices(G);
int id[n];
set frontier;
set next;

for v in G.nodes {
  id[v] = v;
}

frontier = G.nodes;

while (setSize(frontier) > 0) {
  next = {};
  for each element u in frontier {
    for v in G.neighbors(u) {
      if (id[u] < id[v]) {
        id[v] = id[u];
        next.add(v);
      }
    }
  }
  frontier = next;
}

for v in G.nodes {
  print id[v];
}
