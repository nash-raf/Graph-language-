00,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,500,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,1];
int window = 0;
while (window < 10000) {
  G.addEdges(0->256);
  out_degree[0] = out_degree[0] + 1;
  out_degree[256] = out_degree[256] + 1;
  G.addEdges(13->269);
  out_degree[13] = out_degree[13] + 1;
  out_degree[269] = out_degree[269] + 1;
  G.addEdges(26->282);
  out_degree[26] = out_degree[26] + 1;
  out_degree[282] = out_degree[282] + 1;
  G.addEdges(39->295);
  out_degree[39] = out_degree[39] + 1;
  out_degree[295] = out_degree[295] + 1;
  G.addEdges(52->308);
  out_degree[52] = out_degree[52] + 1;
  out_degree[308] = out_degree[308] + 1;
  G.addEdges(65->321);
  out_degree[65] = out_degree[65] + 1;
  out_degree[321] = out_degree[321] + 1;
  G.addEdges(78->334);
  out_degree[78] = out_degree[78] + 1;
