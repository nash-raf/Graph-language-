graph G { directed: true; edges: file "rtest_small.txt"; };
int n = numVertices(G);
int seen[n];
int out[n];
int end[n];
for u in G.nodes {
  if (seen[u] == 0) {
    seen[u] = 1;
    for v in G.neighbors(u) { out[u] = out[u] + v; }
  }
  end[u] = end[u] + 1;
}
int total = 0;
for u in G.nodes { total = total + seen[u] + out[u] + end[u]; }
print total;
