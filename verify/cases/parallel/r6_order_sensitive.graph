// R6, order-sensitivity probe: the same base is written in both regions with
// *non-commuting* read-modify-writes (multiply in the U region, add in the V
// region).  The serial program has a well-defined per-element order: for every
// pair (u,v) in program order, A[u] = A[u]*2 then A[v] = A[v]+1 -- so an
// element that is a neighbour of an earlier source and later a source itself
// sees its +1 *before* its *2.
//
// A staged realization that runs "all U before all V" reproduces the serial
// answer only when the cross-region updates commute; if they do not, the
// realization must fail closed to the serial schedule instead.  This fixture is
// the check: the rewritten answer must equal the unrewritten build.
graph G {
  edges: file "../verify/fixtures/g20k.txt";
};

int n = numVertices(G);
int A[n];

for each vertex v in G {
  A[v] = 1;
}

for each vertex u in G {
  for each neighbor v of u in G {
    A[u] = A[u] * 2;
    A[v] = A[v] + 1;
  }
}

int s = 0;
int i = 0;
while (i < n) { s = s + A[i]; i = i + 1; }
print "ord_sum";
print s;
