}
  G.addEdges(0->256);
  out_degree[0] = out_degree[0] + 1;
  out_degree[256] = out_degree[256] + 1;
  G.addEdges(13->269);
  out_degree[13] = out_degree[13] + 1;
  out_degree[269] = out_degree[269] + 1;
  G.addEdges(26->282);
  out_degree[26] = out_degree[26] + 1;
