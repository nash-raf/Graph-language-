graph G {
  edges: file "/home/user/Course/msk1/2nd/Graph-language-/verify/fixtures/g20k.txt";
};

int n = numVertices(G);
int visited[n];
int lvl[n];
int frontier[n];
int next_frontier[n];
int frontier_size = 1;
int next_size = 0;
int init_i = 0;

while (init_i < n) {
  visited[init_i] = 0;
  lvl[init_i] = -1;
  init_i = init_i + 1;
}

frontier[0] = 0;
visited[0] = 1;
lvl[0] = 0;

while (frontier_size > 0) {
  next_size = 0;
  int i = 0;

  while (i < frontier_size) {
    int v = frontier[i];

    for each neighbor u of v in G {
      if (visited[u] == 0) {
        visited[u] = 1;
        lvl[u] = lvl[v] + 1;
        next_frontier[next_size] = u;
        next_size = next_size + 1;
      }
    }
    i = i + 1;
  }

  swap(frontier, next_frontier);
  frontier_size = next_size;
}

// --- result: reachable count and a checksum over the BFS tree ---
int reached = 0;
int chk = 0;
int q = 0;
while (q < n) {
  if (visited[q] == 1) {
    reached = reached + 1;
    chk = (chk + lvl[q]) % 1000000007;
  }
  q = q + 1;
}
print "reached";
print reached;
print "level_checksum";
print chk;
