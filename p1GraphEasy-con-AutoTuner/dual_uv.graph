graph G {
  edges: file "undirected_small.txt";
};

int n = numVertices(G);
int srcmark[n];
int dstacc[n];

for v in G.nodes {
  srcmark[v] = 0;
  dstacc[v] = 0;
}

for u in G.nodes {
  for v in G.neighbors(u) {
    srcmark[u] = 1;
    dstacc[v] = dstacc[v] + 1;
  }
}

print srcmark[0];
print srcmark[1];
print srcmark[2];
print srcmark[3];
print dstacc[0];
print dstacc[1];
print dstacc[2];
print dstacc[3];
