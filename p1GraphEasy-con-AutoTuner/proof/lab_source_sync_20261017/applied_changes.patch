+  for(int64_t u=m->csr_n*k/j->chunks;u<m->csr_n*(k+1)/j->chunks;++u) {
+   int64_t first=m->csr_row_ptr[u],last=m->csr_row_ptr[u+1];
+   if(first<0||last<first||last>m->csr_m){atomic_store(&j->error,1);return;}
