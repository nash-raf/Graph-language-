// Realistic workload: ingest a fresh user-item interaction window, then run
// delta-style propagation to refresh recommendation scores.
graph InteractionGraph {
  edges: file "../synth_v_50000_e_500000.txt";
};

query pre_refresh: "bfs" of InteractionGraph;

int user_base = 90000;
int item_base = 100000;
int topic_base = 110000;
int event = 0;

while (event < 16) {
  int user = user_base + event;
  int item = item_base + event;
  int topic = topic_base + event;
  add user->item, item->topic to InteractionGraph;
  event = event + 1;
}

int n = numVertices(InteractionGraph);
real damp = 0.85;
real one_over_n = 1.0 / n;
real beta = (1.0 - damp) / n;
real eps2 = 0.01;
real cur_rank[n];
real ngh_sum[n];
real delta[n];
int out_degree[n];
set frontier;
set next;
int round = 0;
int max_rounds = 20;

for each vertex v in InteractionGraph {
  cur_rank[v] = 0.0;
  ngh_sum[v] = 0.0;
  delta[v] = one_over_n;
  out_degree[v] = 0;
}

for each vertex u in InteractionGraph {
  for each neighbor v of u in InteractionGraph {
    out_degree[u] = out_degree[u] + 1;
  }
}

frontier = InteractionGraph.nodes;

while (round < max_rounds) {
  round = round + 1;
  for each element u in frontier {
    real du = delta[u];
    int outd = out_degree[u];
    if (outd > 0) {
      real contrib = du / outd;
      for each neighbor v of u in InteractionGraph {
        ngh_sum[v] = ngh_sum[v] + contrib;
      }
    }
  }

  next = {};
  for each vertex v in InteractionGraph {
    real nd = damp * ngh_sum[v] + beta;
    cur_rank[v] = cur_rank[v] + nd;
    delta[v] = nd;
    real dv = nd;
    if (dv < 0) { dv = 0 - dv; }
    if (dv > eps2) { next.add(v); }
    ngh_sum[v] = 0.0;
  }

  frontier = next;
}

print setSize(frontier);
print cur_rank[0];
