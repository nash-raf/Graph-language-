graph G {
  edges: file "edgelistw.txt";
  TRUE
};

int dist[8];
set frontier;
set next;
int src = 1;

for each vertex v in G {
  dist[v] = 2147483647;
}

dist[src] = 0;
frontier = {1};

while (setSize(frontier) > 0) {
  next = {};
  for each element u in frontier {
    for each neighbor v of u in G {
      int nd = dist[u] + weight(G, u, v);
      if (nd < dist[v]) {
        dist[v] = nd;
        next.add(v);
      }
    }
  }
  frontier = next;
}

print dist[4];
print dist[7];
