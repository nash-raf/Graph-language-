graph G { directed: true; edges: file "test/spatial_pairs.txt"; };
int n = numVertices(G);
int old[n]; int out[n];
for each vertex u in G { out[u] = u + 1; old[u] = out[u]; }
for each vertex u in G { for each neighbor v of u in G { out[v] = old[u] + 2 * out[v] + 1; } }
for each vertex u in G { print out[u]; }
