graph G { directed: true; edges: file "test/spatial_pairs.txt"; };
int n = numVertices(G); int out[n];
set frontier = {0,1,2,3,4,5,6}; set next_frontier = {};
for each element u in frontier {
  for v in G.neighbors(u) {
    if (!next_frontier.contains(v)) { next_frontier.add(v); out[v] = out[v] + 1; }
  }
}
for u in G.nodes { print out[u]; }
