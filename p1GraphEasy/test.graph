






/*
graph mmm { nodes: 0,1,2,3,4; 
edges: 0->1, 1->2, 2->3, 3->4; 
};
query k : "bfs" of G;

*/

graph G{
  //edges: file "../synth_graphs_violin/synth_v_50000_e_1000000_seed_1";
  edges: file "../synth_graphs_violin/synth_v_50000_e_1000000_seed_1.txt";
};
real t0 = timer();
int n = numVertices(G);
int dist[n];
set visited;
set frontier = {2};
int level = 0;
while (frontier.size() > 0) {
    set next_frontier = {};
    for each v in frontier {
        dist[v] = level;
        visited.add(v);
        for each neighbor u of v in G {
            if (!visited.contains(u)) {
                next_frontier.add(u);
            }
        }
    }
    frontier = next_frontier;
    level = level + 1;
}
real t1 = timer();
real elapsed = t1 - t0;
print dist[1];
print elapsed;





