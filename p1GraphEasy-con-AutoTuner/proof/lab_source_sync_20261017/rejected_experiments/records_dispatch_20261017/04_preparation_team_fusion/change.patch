+/* Count/prefix/fill have no user effects between phases. One pool region
+ * can retain the granted team across the prefix without changing chunk order,
+ * callbacks, ownership, allocation failure behavior or the budget ledger. */
+static SGPL_PREPARATION_FN int32_t sgpl_array_prefix_records(SgplArrayPreparation *j) {
+  sgpl_exec_ctx *c=j->ctx;AutoGraphMeta *m=j->meta;
+  int32_t chunks=j->chunks,parts=j->parts,rc;
+  int begins=j->begins,ends=j->ends,native_weighted=j->native_weighted;
+  int64_t *work=j->work,*positions=j->positions;
+  for(int32_t k=0;k<chunks;++k) {
+    if(work[k+1]>j->pair_limit-work[k]) {rc=SGPL_DAG_ERR_INVALID;return rc;}
+    work[k+1]+=work[k];
+  }
+  int64_t pair_count=work[chunks],records=pair_count+(j->source?(begins+ends)*c->array_source_count:0);
+  if((uint64_t)records>SIZE_MAX/12||(uint64_t)pair_count>SIZE_MAX/8/c->array_append_sites) {rc=SGPL_DAG_ERR_NOMEM;return rc;}
+  c->array_work_count=pair_count;
+  c->array_compact_records=SGPL_EXEC_PAIR_BATCH&&!begins&&!ends&&c->op_count==1&&
+      (c->ops[0].capabilities&SGPL_OP_PAIR)&&c->ops[0].pair;
+  /* The row validator and m bound prove every first-match hint fits i32.
+   * Lifecycle records retain their original representation. */
+  if(c->array_compact_records && native_weighted && m->csr_m>=0 && m->csr_m<=INT32_MAX)
+    c->array_compact_records=2;
+  size_t record_bytes=c->array_compact_records==2?20:(c->array_compact_records?16:12);
+  if((uint64_t)records>SIZE_MAX/record_bytes) {rc=SGPL_DAG_ERR_NOMEM;return rc;}
+  c->array_append_log=sgpl_execution_buffer(c,SGPL_BUF_APPEND,(size_t)(pair_count?pair_count:1)*c->array_append_sites*8,1);
+  c->gpu_records=sgpl_execution_buffer(c,SGPL_BUF_RECORDS,(size_t)(records?records:1)*record_bytes,0);
+  if(!c->array_compact_records) {
+    c->gpu_record_sources=sgpl_execution_buffer(c,SGPL_BUF_SOURCES,(size_t)(records?records:1)*8,0);
+    c->gpu_record_work=sgpl_execution_buffer(c,SGPL_BUF_WORK,(size_t)(records?records:1)*8,0);
+  }
+  if(native_weighted&&c->array_compact_records!=2)c->array_record_edges=sgpl_execution_buffer(c,SGPL_BUF_EDGES,(size_t)(records?records:1)*8,0);
+  c->gpu_record_offsets=sgpl_execution_buffer(c,SGPL_BUF_OFFSETS,((size_t)parts+1)*8,1);
+  if(!c->array_append_log||!c->gpu_records||(!c->array_compact_records&&(!c->gpu_record_sources||!c->gpu_record_work))||!c->gpu_record_offsets||
+      (native_weighted&&c->array_compact_records!=2&&!c->array_record_edges)) {rc=SGPL_DAG_ERR_NOMEM;return rc;}
+  int64_t at=0;
+  for(int32_t p=0;p<parts;++p) {
+    c->gpu_record_offsets[p]=at;
+    for(int32_t k=0;k<chunks;++k) {
+      int64_t count=positions[(size_t)k*parts+p];positions[(size_t)k*parts+p]=at;at+=count;
+    }
+  }
+  c->gpu_record_offsets[parts]=at;
+  if(at!=records) {rc=SGPL_DAG_ERR_INVALID;return rc;}
+  return 0;
+}
+static SGPL_PREPARATION_FN void sgpl_array_prepare_team(void *opaque,int32_t worker,int32_t width) {
+  SgplArrayPreparation *j=opaque;
+  sgpl_array_count_chunks(j,worker,width);
+  atomic_fetch_add_explicit(&j->count_done,1,memory_order_release);
+  if(worker==0) {
+    while(atomic_load_explicit(&j->count_done,memory_order_acquire)<width) {
+#if defined(__i386__) || defined(__x86_64__)
+      __asm__ __volatile__("pause");
+#endif
+    }
+    if(!atomic_load_explicit(&j->error,memory_order_relaxed)) {
+      int32_t rc=sgpl_array_prefix_records(j);
+      if(rc<0)atomic_store_explicit(&j->error,rc,memory_order_relaxed);
+    }
+    atomic_store_explicit(&j->fill_ready,1,memory_order_release);
+  } else {
+    while(!atomic_load_explicit(&j->fill_ready,memory_order_acquire)) {
+#if defined(__i386__) || defined(__x86_64__)
+      __asm__ __volatile__("pause");
+#endif
+    }
+  }
+  if(atomic_load_explicit(&j->error,memory_order_relaxed))return;
+  if(j->ctx->array_compact_records==2)sgpl_array_fill_chunks_packed(j,worker,width);
+  else sgpl_array_fill_chunks(j,worker,width);
+}
