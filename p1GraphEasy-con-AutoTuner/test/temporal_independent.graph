graph G { directed: true; edges: file "rtest_small.txt"; };
int n = numVertices(G);
int p[n];
int b[n];
int q[n];
for u in G.nodes {
  p[u] = p[u] + 1;
  for v in G.neighbors(u) { b[u] = b[u] + v + 1; }
  q[u] = q[u] + 1;
}
int total = 0;
for u in G.nodes { total = total + p[u] + b[u] + q[u]; }
print total;
