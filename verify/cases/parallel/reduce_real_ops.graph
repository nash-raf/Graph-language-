// Composition G, floating point: `rsum` is an FAdd reduction; `rmn`/`rmx` use
// the `min`/`max` builtins on reals (select + fcmp, which the optimizer may
// canonicalize to llvm.minnum/maxnum).  Whatever form survives, the combine
// must reproduce the *same* operation as the body -- a min/max that mixes
// minnum with a select flips on NaN and signed zeros.
//
// Assertions: the nests remain sequential under the current exact-fold proof,
// the answer matches an independent Python computation, and outputs agree at
// 1 and 4 threads. This +1.0 count is exact on this fixture, but a fixed combine
// order alone does not prove serial rounding for general floating additions.
graph G {
  edges: file "../verify/fixtures/g20k.txt";
};

int n = numVertices(G);

real rsum = 0.0;
for u in G.nodes {
  for v in G.neighbors(u) {
    rsum = rsum + 1.0;
  }
}

real rmn = 100000000.0;
for u in G.nodes {
  for v in G.neighbors(u) {
    rmn = min(rmn, v);
  }
}

real rmx = -1.0;
for u in G.nodes {
  for v in G.neighbors(u) {
    rmx = max(rmx, v);
  }
}

print "rsum";
print rsum;
print "rmn";
print rmn;
print "rmx";
print rmx;
