// Bi-fan closed form via BITSETS.
// Each source row's target set is packed 31 bits per int (31 not 32: 2^31
// overflows signed int32).  The shared-target count becomes
// popcount(a & b) summed over ceil(T/31) words instead of T multiply-adds.
graph G { directed; edges: file "/tmp/bifan_layer.txt"; };

fn void bifan() {
  int S = 512;
  int T = numVertices(G) - S;
  int Wd = (T + 30) / 31;
  int A[512][100];

  int pow2[31];
  int p = 1;
  int b = 0;
  while (b < 31) { pow2[b] = p; p = p * 2; b = b + 1; }

  int i = 0;
  while (i < S) { int j = 0; while (j < Wd) { A[i][j] = 0; j = j + 1; } i = i + 1; }

  for each edge u, v in G {
    int t = v - S;
    int wq = t / 31;
    int br = t % 31;
    A[u][wq] = A[u][wq] + pow2[br];
  }

  real t0 = timer();
  real total = 0.0;
  i = 0;
  while (i < S) {
    int j = i + 1;
    while (j < S) {
      int c = 0;
      int w = 0;
      while (w < Wd) {
        c = c + popcount_and(A[i][w], A[j][w]);
        w = w + 1;
      }
      total = total + (c * (c - 1)) / 2;
      j = j + 1;
    }
    i = i + 1;
  }
  real t1 = timer();
  print "KERNEL_SEC";
  print t1 - t0;
  print "BIFAN";
  print total;
}
bifan();
