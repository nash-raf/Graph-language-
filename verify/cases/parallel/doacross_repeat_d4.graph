// DOACROSS distance 4, repeated 200x: same recurrence/literal bound as
// doacross_while_d4.graph, wrapped so the site is dispatched many times and
// the DOACROSS sampler can reach a calibrated state (one invocation per process
// cannot).  Inner loop is verbatim from the unwrapped fixture.
int n = 8192;
real pref[8192];
int round = 0;
int i = 0;
while (round < 200)
{
    i = 1;
    while (i < 8192)
    {
        real t = pref[i - 4] * 0.5 + 3.0;
        pref[i] = t + i * 0.25 - 7.0;
        i = i + 1;
    }
    round = round + 1;
}
print "last";
print pref[8191];
