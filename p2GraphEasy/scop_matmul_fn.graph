// Classic affine matmul nest: the canonical Polly target. Written with `while`
// (the only counted-loop form in Base.g4) inside a `fn` so induction variables
// are function-local allocas rather than module-level globals.
// n = numVertices(G) = 7 here, so runtime memory is negligible.
graph G {
  edges: file "edgelistw.txt";
  TRUE
};

fn void kernel() {
  int n = numVertices(G);
  int A[n][n];
  int B[n][n];
  int C[n][n];

  int i = 0;
  while (i < n) {
    int j = 0;
    while (j < n) {
      A[i][j] = i + j;
      B[i][j] = i - j;
      C[i][j] = 0;
      j = j + 1;
    }
    i = i + 1;
  }

  i = 0;
  while (i < n) {
    int j = 0;
    while (j < n) {
      int s = 0;
      int k = 0;
      while (k < n) {
        s = s + A[i][k] * B[k][j];
        k = k + 1;
      }
      C[i][j] = s;
      j = j + 1;
    }
    i = i + 1;
  }

  int r = C[1][1];
  print r;
}

kernel();
