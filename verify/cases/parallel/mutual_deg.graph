graph G {
    directed: true;
    edges: file "../verify/fixtures/mutual5.txt";
};
int n = numVertices(G);
int mdeg[n];
for u in G.nodes {
    int c = 0;
    for v in G.neighbors(u) {
        if (hasEdge(G, v, u)) {
            c = c + 1;
        }
    }
    mdeg[u] = c;
}
int s = 0; int i = 0;
while (i < n) { s = s + mdeg[i]; i = i + 1; }
print "mutdegsum";
print s;
