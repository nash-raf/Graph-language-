graph G { directed: true; edges: file "test/spatial_pairs.txt"; };
int n = numVertices(G);
int frontier[n];
int small_capacity = 1;
int next_frontier[small_capacity];
int hits[n];
frontier[0]=4; frontier[1]=1; frontier[2]=3;
frontier[3]=0; frontier[4]=1; frontier[5]=6;
int frontier_size=6;
int next_size=0;
while(frontier_size>0) {
  next_size=0;
  int p=0;
  while(p<frontier_size) {
    int u=frontier[p];
    for each neighbor v of u in G {
      hits[v]=hits[v]+1;
      if(hits[v]<2) {
        next_frontier[next_size]=v; next_size=next_size+1;
        next_frontier[next_size]=v; next_size=next_size+1;
      }
    }
    p=p+1;
  }
  print p;
  print next_size;
  int i=0;
  while(i<next_size) { print next_frontier[i]; i=i+1; }
  swap(frontier,next_frontier);
  frontier_size=next_size;
}
for each vertex v in G { print hits[v]; }
