graph g1 {
    edges: file "/home/osamanadeem/Downloads/GPL-2026/Graph-language-/synth_graphs/synth_v_50000_e_50000.txt";
};

query bfs_a: "bfs" of g1;

g1.addNodes(500001);
g1.addNodes(500002);
g1.addEdges(2->500001);
g1.addEdges(3->500002);
g1.removeNodes(1);
g1.removeEdges(2->3);

set s_nodes = g1.nodes;
set s_mix = s_nodes intersect g1.nodes;
if (s_mix.contains(500002)) {
    print 1;
} else {
    print 0;
}

query bfs_b: "bfs" of g1;
