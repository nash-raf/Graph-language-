graph G {
  edges: file "/home/user/Course/msk1/benchmark/grapheasy_real_dfs/smoke_logs/clean_graphs/chain.edges";
};

int n = numVertices(G);
int visited[n];
int parent[n];
int stack[n];
int init_i = 0;

while (init_i < n) {
  visited[init_i] = 0;
  parent[init_i] = -1;
  init_i = init_i + 1;
}

int source = 0;
int stack_size = 1;
stack[0] = source;
visited[source] = 1;
parent[source] = source;

while (stack_size > 0) {
  stack_size = stack_size - 1;
  int v = stack[stack_size];

  for each neighbor u of v in G {
    if (visited[u] == 0) {
      visited[u] = 1;
      parent[u] = v;
      stack[stack_size] = u;
      stack_size = stack_size + 1;
    }
  }
}

int reached = 0;
real parent_checksum = 0.0;
int scan_i = 0;

while (scan_i < n) {
  if (visited[scan_i] == 1) {
    reached = reached + 1;
  }
  parent_checksum = parent_checksum + parent[scan_i];
  scan_i = scan_i + 1;
}

print reached;
print parent_checksum;
print parent[0];
