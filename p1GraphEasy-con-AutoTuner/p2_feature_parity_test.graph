graph G {
    nodes: 0, 1, 2, 3, 4;
    edges: 0->1, 1->2, 0->2, 2->3;
};

set all = G.vertices;
set copied = all;
copied.remove(4);

print setSize(all);
print setSize(copied);

graph incident = [G where edge has 2];
set incidentVertices = incident.vertices;
print setSize(incidentVertices);

set keep = {0, 1, 2};
graph induced = [G where vertex in keep];
set inducedVertices = induced.vertices;
print setSize(inducedVertices);

graph combined = [G where degree >= 2 && edge has 2];
set combinedVertices = combined.vertices;
print setSize(combinedVertices);
