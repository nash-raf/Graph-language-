// Bi-fan closed form. Reads a fixed path so the binary is compiled ONCE and
// re-run per layer by overwriting that file.
//   sources 0..511, targets 512..512+T-1   =>  T = numVertices(G) - 512
graph G {
  directed;
  edges: file "/tmp/bifan_layer.txt";
};

fn void bifan() {
  int S = 512;
  int T = numVertices(G) - S;
  int A[512][3072];

  int i = 0;
  while (i < S) {
    int j = 0;
    while (j < T) { A[i][j] = 0; j = j + 1; }
    i = i + 1;
  }

  for each edge u, v in G {
    A[u][v - S] = 1;
  }

  real total = 0.0;
  i = 0;
  while (i < S) {
    int j = i + 1;
    while (j < S) {
      int c = 0;
      int t = 0;
      while (t < T) {
        c = c + A[i][t] * A[j][t];
        t = t + 1;
      }
      total = total + (c * (c - 1)) / 2;
      j = j + 1;
    }
    i = i + 1;
  }
  print "BIFAN";
  print total;
}
bifan();
