graph G { directed: true; edges: file "test/gpu_group_parallel.edges"; };
int n = numVertices(G);
int a[n]; int b[n];
int r = 0;
while (r < 20) {
  for u in G.nodes { for v in G.neighbors(u) { b[u] = b[u] + v + 1; } }
  swap(a,b);
  r = r + 1;
}
for u in G.nodes { print a[u]; print b[u]; }
print r;
