// SGPL workload: bfs_n512_d192_i4_s100_c1_r1000_t4_loop
// Run all variants on this identical source.
graph G {
  edges: file "../graphs/ring_n512_d192.txt";
};
int checksum = 0;
// Phase 0: initial scans.
int probe_0_pre = 0;
while (probe_0_pre < 100) {
query scan_0_pre: "bfs_src" of G;
  probe_0_pre = probe_0_pre + 1;
}
// Phase 0: insert a batch of absent in-bounds edges.
int batch_0 = 0;
while (batch_0 < 1000) {
G.addEdges(0->223);
G.removeEdges(0->223);
G.addEdges(37->260);
G.removeEdges(37->260);
G.addEdges(74->297);
G.removeEdges(74->297);
G.addEdges(111->334);
G.removeEdges(111->334);
  batch_0 = batch_0 + 1;
}
// Phase 0: scan the updated graph.
int probe_0_post = 0;
while (probe_0_post < 4) {
query scan_0_post: "bfs_src" of G;
  probe_0_post = probe_0_post + 1;
}
print checksum;
print numEdges(G);
