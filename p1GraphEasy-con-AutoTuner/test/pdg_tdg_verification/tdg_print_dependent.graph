graph G { edges: file "test/shared_edgelist.txt"; };
int n = numVertices(G);
int right[n];
int init = 0;
while (init < n) {
  right[init] = 0;
  init = init + 1;
}
for each vertex u in G {
  for each neighbor v of u in G {
    print u;
  }
}
for each vertex u in G {
  for each neighbor v of u in G {
    right[u] = right[u] + 1;
  }
}
print right[0];
