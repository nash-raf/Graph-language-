graph G { directed: true; edges: file "rtest_small.txt"; };
int n = numVertices(G);
int p[n];
int b[n];
int q[n];
int acc = 0;
for u in G.nodes {
  acc = u;
  for v in G.neighbors(u) { acc = acc + v; b[u] = acc; }
  q[u] = q[u] + 1;
}
int total = 0;
for u in G.nodes { total = total + b[u] + q[u]; }
print total;
