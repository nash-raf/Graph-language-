// different work per iteration. Each loop writes a separate allocation.
int nl = 65536;
int nr = 65536;
int left[nl];
int right[nr];
int i = 0;
int j = 0;
while (i < nl) {
  left[i] = (i * 17 + 3) % 1009;
  left[i] = (left[i] * 21 + 8) % 1011;
  left[i] = (left[i] * 23 + 9) % 1013;
  left[i] = (left[i] * 25 + 10) % 1015;
  left[i] = (left[i] * 27 + 11) % 1017;
  left[i] = (left[i] * 29 + 12) % 1019;
  left[i] = (left[i] * 31 + 13) % 1021;
  left[i] = (left[i] * 33 + 14) % 1023;
  left[i] = (left[i] * 35 + 15) % 1025;
  left[i] = (left[i] * 37 + 16) % 1027;
  left[i] = (left[i] * 39 + 17) % 1029;
  left[i] = (left[i] * 41 + 18) % 1031;
  left[i] = (left[i] * 43 + 19) % 1033;
  left[i] = (left[i] * 45 + 20) % 1035;
  left[i] = (left[i] * 47 + 21) % 1037;
  left[i] = (left[i] * 49 + 22) % 1039;
  left[i] = (left[i] * 51 + 23) % 1041;
  left[i] = (left[i] * 53 + 24) % 1043;
  left[i] = (left[i] * 55 + 25) % 1045;
  left[i] = (left[i] * 57 + 26) % 1047;
  left[i] = (left[i] * 59 + 27) % 1049;
  left[i] = (left[i] * 61 + 28) % 1051;
  left[i] = (left[i] * 63 + 29) % 1053;
  left[i] = (left[i] * 65 + 30) % 1055;
  left[i] = (left[i] * 67 + 31) % 1057;
  left[i] = (left[i] * 69 + 32) % 1059;
  left[i] = (left[i] * 71 + 33) % 1061;
  left[i] = (left[i] * 73 + 34) % 1063;
  left[i] = (left[i] * 75 + 35) % 1065;
  left[i] = (left[i] * 77 + 36) % 1067;
  left[i] = (left[i] * 79 + 37) % 1069;
  left[i] = (left[i] * 81 + 38) % 1071;
  i = i + 1;
}
while (j < nr) {
  right[j] = (j * 31 + 5) % 1013;
  right[j] = (right[j] * 21 + 8) % 1011;
  right[j] = (right[j] * 23 + 9) % 1013;
  right[j] = (right[j] * 25 + 10) % 1015;
  j = j + 1;
}
print left[65535];
print right[65535];
