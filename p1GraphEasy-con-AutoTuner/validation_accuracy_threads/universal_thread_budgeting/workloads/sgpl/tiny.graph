// launch overhead dominates. Each loop writes a separate allocation.
int nl = 64;
int nr = 64;
int left[nl];
int right[nr];
int i = 0;
int j = 0;
while (i < nl) {
  left[i] = (i * 17 + 3) % 1009;
  left[i] = (left[i] * 21 + 8) % 1011;
  left[i] = (left[i] * 23 + 9) % 1013;
  left[i] = (left[i] * 25 + 10) % 1015;
  i = i + 1;
}
while (j < nr) {
  right[j] = (j * 31 + 5) % 1013;
  right[j] = (right[j] * 21 + 8) % 1011;
  right[j] = (right[j] * 23 + 9) % 1013;
  right[j] = (right[j] * 25 + 10) % 1015;
  j = j + 1;
}
print left[63];
print right[63];
