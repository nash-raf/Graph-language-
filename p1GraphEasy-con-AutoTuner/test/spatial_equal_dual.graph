// Equal constant stores commute, including when the old values are different.
graph G { directed: true; edges: file "test/spatial_pairs.txt"; };
int n = numVertices(G);
int A[n];
for u in G.nodes { A[u] = 7; }
for u in G.nodes { for v in G.neighbors(u) { A[u] = 1; A[v] = 1; } }
int s = 0;
for u in G.nodes { s = s + A[u]; }
print s;
