graph G { edges: file "/mnt/d/sgpl/Graph-language-/p1GraphEasy-con-AutoTuner/bench_results/algos_scalability_20260921_031033/graphs/synth_v_1000000_e_1000000_bench.txt"; };
int n = numVertices(G);
int deg[n];
for each vertex v in G {
  deg[v] = 0;
}
for each vertex u in G {
  for each neighbor v of u in G {
    int sh = u + 1;
    deg[sh] = deg[sh] + 1;
  }
}
print deg[0];
