graph G {
  edges: file "synth_v_50000_e_500000.txt";
};

int n = numVertices(G);
int visited[n];
int dist[n];

for each vertex v in G {
    visited[v] = 0;
    dist[v] = -1;
}

dist[0] = 0;
visited[0] = 1;

set frontier = {0};
set next_frontier = {};

while (setSize(frontier) > 0) {
    next_frontier = {};
    for each element v in frontier {
        for each neighbor u of v in G {
            if (visited[u] == 0) {
                visited[u] = 1;
                dist[u] = dist[v] + 1;
                next_frontier.add(u);
            }
        }
    }
    frontier = next_frontier;
}

print dist[100];
