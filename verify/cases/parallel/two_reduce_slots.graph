// Two scalar accumulators in one neighbour body. R3 gives each slot its own
// per-partition partial and combines the partials after the workers join.
// The nest must be classified privatized and match the serial build:
// a = 10, b = 20. Both slots must be private in the spatial proof; the legacy
// single-ReducePtr layout cannot safely execute the second slot in parallel.
graph G {
  edges: file "../verify/fixtures/tiny.txt";
};

int n = numVertices(G);
int a = 0;
int b = 0;

for u in G.nodes {
  for v in G.neighbors(u) {
    a = a + 1;
    b = b + 2;
  }
}

print "a";
print a;
print "b";
print b;
