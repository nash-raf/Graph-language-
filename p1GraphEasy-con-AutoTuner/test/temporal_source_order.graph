graph G { directed: true; edges: file "rtest_small.txt"; };
int n = numVertices(G);
int pairs[n];
int expected = 0;
int bad = 0;
for each vertex u in G {
  if (u != expected) { bad = bad + 1; }
  for each neighbor v of u in G { pairs[u] = pairs[u] + v; }
  expected = expected + 1;
}
int total = 0;
for each vertex u in G { total = total + pairs[u]; }
print total;
print expected;
print bad;
