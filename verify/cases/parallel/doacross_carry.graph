// A carried (distance-1) recurrence with dyadic arithmetic, so device and CPU
// must agree exactly.  n is chosen so both cost gates admit the wave kernel by
// default: trips = 8191 >= SGPL_GPU_MIN_TRIPS (4096) and waves = trips/1 = 8191
// <= SGPL_GPU_MAX_WAVES (8192).  The effect system derives space=Carried
// doacross_dist=1, the cooperative wave kernel realises it, and the value is
// compared against the CPU build (which is the reference here).
int n = 8192;
real pref[8192];
int i = 1;
while (i < 8192)
{
    real t = pref[i - 1] * 0.5 + 3.0;
    pref[i] = t + i * 0.25 - 7.0;
    i = i + 1;
}
print "last";
print pref[8191];
