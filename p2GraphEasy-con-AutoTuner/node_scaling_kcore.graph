graph G {
  edges: file "/home/user/Course/msk1/benchmark/node_scaling_10m_edges/graphs/current_unweighted.txt";
};

int n = numVertices(G);
int k = 5;
int deg[n];
int alive[n];
set frontier;
set next;

for v in G.nodes {
  deg[v] = 0;
  alive[v] = 1;
}

for u in G.nodes {
  for v in G.neighbors(u) {
    deg[u] = deg[u] + 1;
  }
}

frontier = {};
for v in G.nodes {
  if (deg[v] < k) {
    frontier.add(v);
  }
}

while (setSize(frontier) > 0) {
  next = {};
  for each element u in frontier {
    if (alive[u] == 1) {
      alive[u] = 0;
      for v in G.neighbors(u) {
        if (alive[v] == 1) {
          deg[v] = deg[v] - 1;
          if (deg[v] < k) {
            next.add(v);
          }
        }
      }
    }
  }
  frontier = next;
}
