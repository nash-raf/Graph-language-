graph G { directed: true; edges: file "test/gpu_group_parallel.edges"; };
int n = numVertices(G);
int source[n]; int dest[n]; int accumulated[n]; int indirect[n]; int index[n];
int seen[n]; int claimed[n]; int acc = 0;
for u in G.nodes { index[u] = u % 4; }
for u in G.nodes {
  source[u] = 3;
  for v in G.neighbors(u) { source[u] = source[u] + v + 1; }
}
for u in G.nodes { for v in G.neighbors(u) { dest[v] = dest[v] + u + 1; } }
for u in G.nodes {
  acc = 0;
  for v in G.neighbors(u) { acc = acc + v + 1; }
  accumulated[u] = acc;
}
for u in G.nodes { for v in G.neighbors(u) { indirect[index[v]] = indirect[index[v]] + u + 1; } }
for u in G.nodes {
  if (seen[u] == 0) { seen[u] = 1; for v in G.neighbors(u) { claimed[v] = claimed[v] + u + 1; } }
}
set frontier = {}; set next_frontier = {};
int fill = 0;
while (fill < n) { frontier.add(fill); fill = fill + 1; }
for each element u in frontier { for v in G.neighbors(u) { next_frontier.add(v); } }
int rounds[9]; int r = 0; int round_acc = 0;
while (r < 9) {
  r = r + 1; round_acc = 0;
  for u in G.nodes { for v in G.neighbors(u) { round_acc = round_acc + v + 1; } }
  rounds[r - 1] = round_acc + r;
}
for u in G.nodes { print source[u]; print dest[u]; print accumulated[u]; print indirect[u]; print claimed[u]; }
print next_frontier.size(); print r;
int q = 0;
while (q < 9) { print rounds[q]; q = q + 1; }
