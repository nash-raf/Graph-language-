graph G { edges: file "/mnt/d/sgpl/Graph-language-/p1GraphEasy-con-AutoTuner/bench_results/algos_scalability_20260921_022703/graphs/synth_v_1000000_e_1000000_bench.txt"; };
int n = numVertices(G);
int visited[n];
int parent[n];
set frontier;
set next;

for each vertex v in G {
  visited[v] = 0;
  parent[v] = -1;
}

frontier = {0};
visited[0] = 1;
parent[0] = 0;

while (setSize(frontier) > 0) {
  next = {};
  for each element v in frontier {
    for each neighbor u of v in G {
      if (visited[u] == 0) {
        visited[u] = 1;
        parent[u] = v;
        next.add(u);
      }
    }
  }
  frontier = next;
}

int checksum = 0;
int ci = 0;
while (ci < n) {
  checksum = checksum + parent[ci];
  ci = ci + 1;
}
print checksum;
