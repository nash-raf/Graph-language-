graph G { edges: file "../verify/fixtures/g20k.txt"; };
int n = numVertices(G);
real val[n];
real acc[n];
int round = 0;
for v in G.nodes { val[v] = 1.0; acc[v] = 0.0; }
while (round < 20) {
  round = round + 1;
  for u in G.nodes {
    real s = 0.0;
    for v in G.neighbors(u) {
      s = s + val[v] * 0.5;
    }
    acc[u] = s;
  }
  for v in G.nodes { val[v] = 1.0 + acc[v] * 0.0001; }
}
real tot = 0.0; int q = 0;
while (q < n) { tot = tot + acc[q]; q = q + 1; }
print "checksum"; print tot;
