graph G {
  edges: file "directed_weighted_small.txt";
  TRUE
};

int n = numVertices(G);
int inf = 2147483647;
int dist[n];
set frontier;
set next;
int src = 0;
int rounds = 0;

for v in G.nodes {
  dist[v] = inf;
}

dist[src] = 0;
frontier = {0};

while (setSize(frontier) > 0) {
  if (rounds == n) {
    break;
  }
  next = {};
  for each element u in frontier {
    if (dist[u] != inf) {
      for v in G.neighbors(u) {
        int nd = dist[u] + weight(G, u, v);
        if (nd < dist[v]) {
          dist[v] = nd;
          next.add(v);
        }
      }
    }
  }
  frontier = next;
  rounds = rounds + 1;
}

print dist[0];
print dist[1];
print dist[2];
print dist[3];
