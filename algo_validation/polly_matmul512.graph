// Canonical Polly target: 3-deep affine nest with reuse, all state local to the
// `fn` so induction variables and array bases are allocas (mem2reg -> SSA)
// rather than loads from globals.
graph G { edges: file "/home/user/Course/msk1/2nd/Graph-language-/algo_validation/ba/ba_25000_49996.txt"; };

fn void matmul() {
  int n = 512;
  int A[n][n];
  int B[n][n];
  int C[n][n];

  int i = 0;
  while (i < n) {
    int j = 0;
    while (j < n) {
      A[i][j] = (i + j) % 7;
      B[i][j] = (i * 2 + j) % 5;
      C[i][j] = 0;
      j = j + 1;
    }
    i = i + 1;
  }

  i = 0;
  while (i < n) {
    int j = 0;
    while (j < n) {
      int s = 0;
      int k = 0;
      while (k < n) {
        s = s + A[i][k] * B[k][j];
        k = k + 1;
      }
      C[i][j] = s;
      j = j + 1;
    }
    i = i + 1;
  }

  int chk = 0;
  i = 0;
  while (i < n) {
    int j = 0;
    while (j < n) {
      chk = (chk + C[i][j]) % 1000000007;
      j = j + 1;
    }
    i = i + 1;
  }
  print "matmul_checksum";
  print chk;
}

matmul();
