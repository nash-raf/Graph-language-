// Reference 50k fair traverse-then-update workload.
// Full parameterized ladder: bench_traverse_update_scaling.py
// → traverse_update_workloads/traverse_update_n50000.graph
graph WorkGraph {
  edges: file "../synth_v_50000_e_500000.txt";
};

int checksum = 0;

for each vertex u in WorkGraph {
  for each neighbor v of u in WorkGraph {
    checksum = checksum + v;
  }
}

