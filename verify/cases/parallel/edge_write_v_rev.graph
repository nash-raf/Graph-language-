// Destination-keyed write over an edge loop: two sources (0 and 3) both write a[1].
//   edges: 0->1, 1->2, 1->3, 3->1
//   a[1] = 0 or 3 depending on the order the two incoming edges are processed.
// The question this fixture settles: does the dependence analysis claim DOALL here
// (a false proof -> order-dependent answer), or does it refuse and let ownership
// (destination-partitioning) make the order deterministic?
graph G {
  edges: file "../verify/fixtures/race4_rev.txt";
};
int n = numVertices(G);
int a[n];
for each vertex v in G { a[v] = -1; }
for each vertex u in G {
  for each neighbor v of u in G {
    a[v] = u;
  }
}
print "a";
print a[0];
print a[1];
print a[2];
print a[3];
