graph G {
  edges: file "/home/user/Course/msk1/synth_graphs_weighted/synth_v_1000000_e_1000000_w.txt";
  //edges: file "../../../synth_graphs_weighted/edgelist2.txt";
  TRUE
};

int n = numVertices(G);
int inf = 2147483647;
int dist[n];
set frontier;
set next;
int src = 1;
int rounds = 0;

for each vertex v in G {
  dist[v] = inf;
}

dist[src] = 0;
frontier = {1};

while (setSize(frontier) > 0) {
  if (rounds == n) {
    print "negative cycle";
    break;
  }

  next = {};
  for each element u in frontier {
    if (dist[u] != inf) {
      for each neighbor v of u in G {
        int nd = dist[u] + weight(G, u, v);
        if (nd < dist[v]) {
          dist[v] = nd;
          next.add(v);
        }
      }
    }
  }
  frontier = next;
  rounds = rounds + 1;
}

