+    }
+    if (tdg_debug_enabled())
+        fprintf(stderr, "[tdg.phases] ordinary=%d loop_tasks=%d tasks=%d\n",
+                ordinary, task_count - ordinary, task_count);
+    sgpl_run_tdg_phase(ordered, ordinary, work_units, span_units);
+    sgpl_run_tdg_phase(ordered + ordinary, task_count - ordinary, work_units, span_units);
