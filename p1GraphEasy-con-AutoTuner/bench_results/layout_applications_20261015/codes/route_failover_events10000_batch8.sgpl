// Path switching, gateway outage impact, alternate-route commissioning, and recovery checks.
// Synthetic projected-community fixture shared by all five different programs.
graph G { edges: file "../graphs/community_projection.txt"; };
int n=numVertices(G);
int window = 0;
while (window < 10000) {
  G.removeEdges(402->502);
  G.addEdges(0->256);
  G.removeEdges(0->256);
  G.addEdges(402->502);
  G.removeEdges(403->503);
  G.addEdges(13->269);
  G.removeEdges(13->269);
  G.addEdges(403->503);
  G.removeEdges(404->504);
  G.addEdges(26->282);
  G.removeEdges(26->282);
  G.addEdges(404->504);
  G.removeEdges(405->505);
  G.addEdges(39->295);
  G.removeEdges(39->295);
  G.addEdges(405->505);
  G.removeEdges(406->506);
  G.addEdges(52->308);
  G.removeEdges(52->308);
  G.addEdges(406->506);
  G.removeEdges(407->507);
  G.addEdges(65->321);
  G.removeEdges(65->321);
  G.addEdges(407->507);
  G.removeEdges(408->508);
  G.addEdges(78->334);
  G.removeEdges(78->334);
  G.addEdges(408->508);
  G.removeEdges(409->509);
  G.addEdges(91->347);
  G.removeEdges(91->347);
  G.addEdges(409->509);
  window = window + 1;
}
// Check outage impact, commission the alternate gateway, and verify recovery.
G.removeEdges(0->512);
query outage_core: "bfs_src" 0 of G;
query stranded_clients: "bfs_src" 543 of G;
print outage_core; print stranded_clients;
G.addEdges(1->512);
query recovered: "bfs_src" 0 of G;
query inspection: "dfs_src" 543 of G;
print recovered; print inspection;
print numEdges(G);
