graph G {
    directed: true;
    edges: file "../verify/fixtures/bipartite.txt";
};
int n = numVertices(G);
int deg[n];
for u in G.nodes {
    int c = 0;
    for v in G.neighbors(u) {
        c = c + 1;
    }
    deg[u] = c;
}
int s = 0; int i = 0;
while (i < n) { s = s + deg[i]; i = i + 1; }
print "degsum";
print s;
